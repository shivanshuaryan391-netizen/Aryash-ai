# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Never expose this key in client-side code or commit real keys to version control.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model used by ARYASH AI.
# Defaults to gemini-4-hydrogen (fast, free-tier eligible).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Public URL where the application is hosted.
APP_URL="http://localhost:3000"

# OPTIONAL FUTURE SUPABASE FREE-TIER INTEGRATION
# Leave unset to run completely free with browser localStorage persistence.
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY=""
